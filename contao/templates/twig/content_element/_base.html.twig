{% extends "@Contao/content_element/_base.html.twig" %}

{% set attributes = attributes|default(attrs()).addClass(getAllResponsiveClasses(data|default)).mergeWith(attributes|default) %}
{% set attributes = data|default ? attributes|default(attrs()).addClass(getContainerClasses(data.responsiveContainer|default, data.type|default)).mergeWith(attributes|default) : attributes %}

{% if type is defined and type == 'element_group' and data|default %}
    {% set groupSpacingTopClasses = getGroupSpacingClasses(data.responsiveGroupSpacingTop|default(''), 't') %}
    {% set groupSpacingBottomClasses = getGroupSpacingClasses(data.responsiveGroupSpacingBottom|default(''), 'b') %}
    {# move the spacing data-attribute to 'content__main' when using a background element, mirroring mod_article. #}
    {% set groupHasBackground = data.background and hasBackground(data.background) %}
    {% if groupSpacingTopClasses %}
        {% set attributes = attrs().addClass(groupSpacingTopClasses|join(' ')).mergeWith(attributes|default) %}
        {% if groupHasBackground %}
            {% set content_main_attributes = attrs().set('data-spacing-top').mergeWith(content_main_attributes|default) %}
        {% else %}
            {% set attributes = attrs().set('data-spacing-top').mergeWith(attributes|default) %}
        {% endif %}
    {% endif %}
    {% if groupSpacingBottomClasses %}
        {% set attributes = attrs().addClass(groupSpacingBottomClasses|join(' ')).mergeWith(attributes|default) %}
        {% if groupHasBackground %}
            {% set content_main_attributes = attrs().set('data-spacing-bottom').mergeWith(content_main_attributes|default) %}
        {% else %}
            {% set attributes = attrs().set('data-spacing-bottom').mergeWith(attributes|default) %}
        {% endif %}
    {% endif %}
{% endif %}

{% set inner_classes = getAllInnerContainerClasses(data|default)|join(" ") %}

{%- block inner %}
    {% if nested_fragments %}
        <div class="content__inside inside {{ inner_classes }}">{{ parent() }}</div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock -%}

{% block content %}
    <div {{ content_attributes }}>
        {{ block('content')|raw }}
    </div>
{% endblock %}
